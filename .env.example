# Copy this file to .env and fill in your key.
# Only OPENROUTER_API_KEY is required. Every evidence source is a free public
# API - no other account, key or service is needed to run this.

# ── LLM + embeddings (OpenRouter: one provider for every model) ──
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
LLM_MODEL=google/gemini-2.5-flash-lite
LLM_HEAVY_MODEL=google/gemini-2.5-flash
LLM_PLANNER_MODEL=google/gemini-3-flash-preview
OPENROUTER_RPM_LIMIT=200
OPENROUTER_TPM_LIMIT=200000

EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_MODEL_RERANK=openai/text-embedding-3-large

# ── Outbound identity ──
# Sent as the mailto: in the User-Agent of every request. NCBI, Crossref and
# OpenAlex give identified clients a more generous rate limit; set your own
# address if you query them regularly.
CONTACT_EMAIL=anonymous@example.com

# ── PubMed (optional) ──
# Raises the NCBI limit from 3 to 10 req/s. Free: https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# ── openFDA (optional) ──
# Raises the limit from 1,000 to 120,000 requests/day. Free: https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# ── Search tunables ──
SEARCH_TIMEOUT_SECONDS=45
SOURCE_CACHE_TTL_DAYS=30
SOURCE_CACHE_MAX_ENTRIES=2000
TOPIC_CACHE_MAX_ENTRIES=500

# ── API auth (optional) ──
# If set, clients must send a matching X-API-Key header. Leave blank for an
# open API - fine for local use.
API_KEY=

# ── CORS (optional) ──
# Only needed if a frontend on another origin calls this API. The bundled UI
# is same-origin and needs nothing here. JSON list, e.g. ["https://example.com"]
# CORS_ALLOW_ORIGINS=https://example.com,https://app.example.com
CORS_ALLOW_ORIGINS=
